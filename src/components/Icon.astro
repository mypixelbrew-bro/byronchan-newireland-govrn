---
interface Props {
  name: 'record' | 'budget' | 'campaign' | 'contact' | 'phone' | 'document' | 'share' | 'attend' | 'volunteer' | 'play' | 'facebook';
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  record: 'M7 3h7l4 4v14H7V3z M14 3v4h4 M9 12h6 M9 16h6 M9 8h2',
  budget: 'M4 20h16 M6 20V10 M11 20V6 M16 20V13 M4 20h0',
  campaign: 'M3 11v2a1 1 0 001 1h2l4 4V6L6 10H4a1 1 0 00-1 1z M14 8a4 4 0 010 8 M17 5a8 8 0 010 14',
  contact: 'M4 5h3l2 5-2 1a11 11 0 005 5l1-2 5 2v3a2 2 0 01-2 2A16 16 0 013 7a2 2 0 012-2z',
  phone: 'M4 5h3l2 5-2 1a11 11 0 005 5l1-2 5 2v3a2 2 0 01-2 2A16 16 0 013 7a2 2 0 012-2z',
  document: 'M7 3h7l4 4v14H7V3z M14 3v4h4 M9 12h6 M9 16h6',
  share: 'M18 8a3 3 0 100-6 3 3 0 000 6z M6 15a3 3 0 100-6 3 3 0 000 6z M18 22a3 3 0 100-6 3 3 0 000 6z M8.6 13.5l6.8-3.8 M8.6 10.5l6.8 3.8',
  attend: 'M4 6h16v14H4V6z M4 10h16 M8 3v5 M16 3v5 M9 14h2 M13 14h2 M9 17h2',
  volunteer: 'M12 20s-7-4.35-9.5-8.5C1 8.5 2.5 5 6 5c2 0 3.5 1.2 4 2.3C10.5 6.2 12 5 14 5c3.5 0 5 3.5 3.5 6.5C15 15.65 12 20 12 20z',
  play: 'M9 6l10 6-10 6V6z',
  facebook: 'M13 21v-8h3l.5-3.5H13V7.3c0-1 .3-1.8 1.8-1.8H17V2.2C16.6 2.1 15.4 2 14 2c-3 0-4.8 1.7-4.8 5v2.5H6V13h3.2v8h3.8z',
};

const strokeIcons = new Set(['record', 'budget', 'campaign', 'contact', 'phone', 'document', 'share', 'attend', 'volunteer']);
---

{strokeIcons.has(name) ? (
  <svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d={paths[name]} />
  </svg>
) : (
  <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d={paths[name]} />
  </svg>
)}
