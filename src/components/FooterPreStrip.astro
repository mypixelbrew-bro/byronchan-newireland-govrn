---
import IconServiceCard from './IconServiceCard.astro';
---

<div class="pre-strip section">
  <div class="wrap">
    <div class="service-cards">
      <IconServiceCard
        icon="phone"
        heading="Contact the office"
        description="Reach the Governor's provincial office in Kavieng or the parliamentary office in Waigani."
        linkLabel="Get in touch →"
        linkHref="/contact/"
      />
      <IconServiceCard
        icon="document"
        heading="See the full budget"
        description="A record K499.6 million revised budget, broken down sector by sector."
        linkLabel="View the budget →"
        linkHref="/budget/"
      />
      <IconServiceCard
        icon="share"
        heading="Share this site"
        description="The record and the budget are all here. Share the link with your community."
        linkLabel="Share the site →"
        linkHref="/campaign/#involved"
      />
    </div>
  </div>
</div>
