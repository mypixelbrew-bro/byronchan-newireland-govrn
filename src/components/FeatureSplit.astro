---
interface LinkItem {
  label: string;
  href: string;
}

interface Props {
  image: string;
  imageAlt: string;
  heading: string;
  body: string;
  links?: LinkItem[];
  reverse?: boolean;
  headingId?: string;
}

const { image, imageAlt, heading, body, links, reverse = false, headingId } = Astro.props;
---

<div class:list={['feature-split', { reverse }]}>
  <div class="feature-split-media">
    <img src={image} alt={imageAlt} loading="lazy" width="800" height="600" />
  </div>
  <div class="feature-split-body">
    <h2 id={headingId}>{heading}</h2>
    <p>{body}</p>
    {links && links.length > 0 && (
      <ul class="feature-split-links">
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    )}
  </div>
</div>
