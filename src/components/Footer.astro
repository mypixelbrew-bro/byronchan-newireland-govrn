---
import Icon from './Icon.astro';
---

<footer class="site-footer">
  <div class="wrap section">
    <div class="footer-grid">
      <div class="footer-col">
        <h4>Office of the Governor</h4>
        <p>
          New Ireland Provincial Government Headquarters<br />
          Kavieng, New Ireland Province<br />
          Papua New Guinea
        </p>
        <p class="mt-sm">
          <a href="https://facebook.com/byronchangovernor" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="footer-social">
            <Icon name="facebook" class="footer-social-icon" />
          </a>
        </p>
      </div>

      <div class="footer-col">
        <h4>Site</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/budget/">Record & Budget</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/province/">New Ireland</a></li>
          <li><a href="/campaign/">Campaign</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Info</h4>
        <ul>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/authorisation/">Authorisation & Privacy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>Authorised by the Office of the Governor, New Ireland Province, Papua New Guinea.</span>
