---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb wrap" aria-label="Breadcrumb">
  {items.map((item, i) => (
    <>
      {i > 0 && <span> / </span>}
      {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
    </>
  ))}
</nav>
