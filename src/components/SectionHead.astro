---
interface Props {
  title: string;
  subtitle?: string;
  metaLabel?: string;
  metaHref?: string;
}

const { title, subtitle, metaLabel, metaHref } = Astro.props;
---

<div class="section-head">
  <div class="section-head-text">
    <h2>{title}</h2>
    {subtitle && <p class="subtitle">{subtitle}</p>}
  </div>
  {metaLabel && (
    metaHref ? (
      <a href={metaHref} class="section-head-meta">{metaLabel}</a>
    ) : (
      <span class="section-head-meta">{metaLabel}</span>
    )
  )}
</div>
