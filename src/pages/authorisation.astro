---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Authorisation & Privacy — Hon. Byron Chan MP, Governor of New Ireland"
  description="Authorisation statement and privacy policy for the official website of Hon. Byron Chan MP, Governor of New Ireland Province."
  path="/authorisation/"
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Authorisation & Privacy' }]}
>
  <div class="wrap page-heading">
    <h1>Authorisation and privacy</h1>
  </div>

  <section class="section prose" style="padding-top:0;">
    <div class="wrap">
      <h2>Authorisation</h2>
      <div class="mt-md">
        <p>This website is authorised by [AGENT NAME], [AGENT ADDRESS], for and on behalf of Hon. Byron Chan MP, Governor of New Ireland Province.</p>
        <p class="muted" style="font-size:13px;">[PLACEHOLDER: Review and update to comply with current PNG Electoral Commission requirements before publishing.]</p>
      </div>
    </div>
  </section>

  <section class="section section--paper prose">
    <div class="wrap">
      <h2>Privacy</h2>
      <div class="mt-md">
        <p>This website does not use cookies, does not serve advertisements, and does not track visitors using third-party analytics. Basic anonymised traffic statistics are collected via Vercel Analytics, which does not use cookies or collect personally identifiable information.</p>
        <p>For questions about how your information is handled, contact the Governor's office at <a href="mailto:governor@newireland.gov.pg">governor@newireland.gov.pg</a>.</p>
      </div>
    </div>
  </section>
</PageLayout>
